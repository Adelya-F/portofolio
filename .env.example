# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# PostgreSQL connection string (Neon, Supabase, or any Postgres host).
# Prisma supports the standard postgresql:// connection string format.
# See: https://pris.ly/d/connection-strings
DATABASE_URL=""

# Resend API key, used to send the contact-form notification email.
# Get one at https://resend.com/api-keys after creating a free account.
RESEND_API_KEY=""

# The inbox that should receive contact-form notifications (your email).
CONTACT_EMAIL=""

# Secret used to sign/encrypt admin session tokens. Generate one with:
#   npx auth secret
# or any random 32+ byte string (e.g. `openssl rand -base64 32`).
NEXTAUTH_SECRET=""

# The base URL of your site. Use http://localhost:3000 locally; your real
# domain (e.g. https://yourdomain.com) in production.
NEXTAUTH_URL=""
