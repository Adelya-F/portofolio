# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# PostgreSQL connection string (Neon, Supabase, or any Postgres host).
# Prisma supports the standard postgresql:// connection string format.
# See: https://pris.ly/d/connection-strings
DATABASE_URL=""

# Resend API key, used to send the contact-form notification email.
# Get one at https://resend.com/api-keys after creating a free account.
RESEND_API_KEY=""

# The inbox that should receive contact-form notifications (your email).
CONTACT_EMAIL=""

# Secret used to sign/encrypt admin session tokens. Generate one with:
#   npx auth secret
# or any random 32+ byte string (e.g. `openssl rand -base64 32`).
NEXTAUTH_SECRET=""

# The base URL of your site. Use http://localhost:3000 locally; your real
# domain (e.g. https://yourdomain.com) in production.
NEXTAUTH_URL=""

# Public base URL of the site, used for canonical URLs, Open Graph tags, and
# sitemap.xml. Set this to your production domain on Vercel
# (e.g. https://adelya.vercel.app). Falls back to NEXTAUTH_URL if unset.
NEXT_PUBLIC_SITE_URL=""

# --- Not read from this file — listed here so you know they exist ---
#
# ADMIN_EMAIL / ADMIN_PASSWORD are read only by scripts/create-admin.ts, a
# one-time script you run yourself to create the admin account. They are NOT
# needed by the deployed app, so do NOT add them as Vercel project
# environment variables. Pass them inline instead, e.g.:
#   ADMIN_EMAIL="you@example.com" ADMIN_PASSWORD="a-strong-password" npx tsx scripts/create-admin.ts
