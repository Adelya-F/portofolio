# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# PostgreSQL connection string (Neon, Supabase, or any Postgres host).
# Prisma supports the standard postgresql:// connection string format.
# See: https://pris.ly/d/connection-strings
DATABASE_URL=""

# Resend API key, used to send the contact-form notification email.
# Get one at https://resend.com/api-keys after creating a free account.
RESEND_API_KEY=""

# The inbox that should receive contact-form notifications (your email).
CONTACT_EMAIL=""
